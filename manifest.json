{
  "manifest_version": 3,
  "name": "YouTube + ChatGPT: grupos de pestañas",
  "version": "1.0.1",
  "description": "Agrupa el vídeo silenciado y su conversación al pulsar el botón del userscript YouTube → ChatGPT.",
  "minimum_chrome_version": "120",
  "permissions": [
    "tabGroups"
  ],
  "background": {
    "service_worker": "extension/background.mjs",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": [
        "extension/bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "homepage_url": "https://github.com/alexx-ftw/youtube-chatgpt"
}
